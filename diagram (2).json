{
  "version": 1,
  "author": "Smart Fire & Gas Safety System",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 172.8, "left": 504.04, "attrs": {} },
    {
      "type": "wokwi-gas-sensor",
      "id": "mq2",
      "top": 31.5,
      "left": -21.8,
      "attrs": { "ppm": "400", "threshold": "4.4" }
    },
    {
      "type": "wokwi-potentiometer",
      "id": "smokePot",
      "top": 280,
      "left": 45,
      "attrs": { "value": "0" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "flame",
      "top": 495.8,
      "left": 86.4,
      "attrs": { "color": "orange", "label": "FLAME / FIRE", "key": "F", "bounce": "0" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "resetButton",
      "top": 500,
      "left": 800,
      "attrs": { "color": "blue", "label": "SILENCE ALARM", "key": "R", "bounce": "0" }
    },
    {
      "type": "board-ssd1306",
