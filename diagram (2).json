    {
      "type": "wokwi-resistor",
      "id": "rRed",
      "top": 240,
      "left": 835,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "rGreen",
      "top": 285,
      "left": 835,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "rBlue",
      "top": 330,
      "left": 835,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-resistor",
      "id": "rExhaust",
      "top": 465,
      "left": 1080,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-led",
